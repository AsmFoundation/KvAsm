<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- net8.0: current LTS consumers; net10.0: latest runtime and APIs. -->
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <RootNamespace>KvAsm.Client</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsAotCompatible>true</IsAotCompatible>
    <PackageId>KvAsm.Client</PackageId>
    <!-- Must equal the server's VERSION_STR (server/src/main.asm) and the git
         tag being released: .github/workflows/release.yml refuses to publish
         a package whose version differs from the tag. -->
    <Version>0.3.0</Version>
    <Description>.NET client for KvAsm, the gRPC key-value server written in x86-64 assembly: Get/Put/Delete, streaming Upload/Download of large values and ranges with CRC-32C verification, health checks, long-key compaction and snapshot file writing.</Description>
  </PropertyGroup>

  <!--
    NuGet package metadata (nuget.org shows all of it). Repository URL and
    commit come from Source Link, which the .NET 8+ SDK includes: in CI the
    checkout's origin is the GitHub repository, so every pdb line maps to the
    exact source on GitHub. A local pack from a clone without a remote only
    warns that the source link is empty; publishing happens from CI.
  -->
  <PropertyGroup>
    <Authors>Eli Belash</Authors>
    <Copyright>Copyright 2026 Eli Belash</Copyright>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/AsmFoundation/KvAsm</PackageProjectUrl>
    <RepositoryUrl>https://github.com/AsmFoundation/KvAsm</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <!-- The AsmFoundation A (client/dotnet/icon.png): nuget.org, the IDEs' package managers and a nuget.org
         link's preview show it instead of NuGet's default box. -->
    <PackageIcon>icon.png</PackageIcon>
    <PackageTags>kvasm;key-value;kv-store;grpc;http2;assembly;x86-64;crc32c;snapshot</PackageTags>
    <PackageReleaseNotes>https://github.com/AsmFoundation/KvAsm/blob/main/CHANGELOG.md</PackageReleaseNotes>
    <!-- Symbols go to nuget.org's symbol server as a .snupkg next to the
         package; the protobuf/gRPC sources generated at build time are not
         in git, so they are embedded in the pdb for debuggers to step into. -->
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>

  <ItemGroup>
    <!-- The package's readme is the client's own README (absolute links, so
         they work on nuget.org too). NOTICE travels with every redistribution
         of the package, as Apache-2.0 section 4(d) asks. -->
    <None Include="..\..\README.md" Pack="true" PackagePath="\" Visible="false" />
    <None Include="..\..\..\..\NOTICE" Pack="true" PackagePath="\" Visible="false" />
    <None Include="..\..\icon.png" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Google.Protobuf" />
    <PackageReference Include="Grpc.HealthCheck" />
    <PackageReference Include="Grpc.Net.Client" />
    <PackageReference Include="Grpc.Tools" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- The one contract shared with the server and every other client. -->
    <Protobuf Include="..\..\..\..\proto\kvasm\v1\kvasm.proto"
              ProtoRoot="..\..\..\..\proto"
              GrpcServices="Client"
              Link="Protos\kvasm\v1\kvasm.proto" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="KvAsm.Client.Tests" />
  </ItemGroup>

</Project>
