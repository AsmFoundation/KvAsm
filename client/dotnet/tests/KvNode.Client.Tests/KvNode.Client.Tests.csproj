<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Both library targets are tested: a bug can hide in one runtime only. -->
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <!-- xunit.v3 test projects are self-hosting executables. -->
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>KvNode.Client.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Testcontainers" />
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\KvNode.Client\KvNode.Client.csproj" />
  </ItemGroup>

</Project>
