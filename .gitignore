# Server build outputs (objects, binaries, test executables, bench results).
/server/build/

# Benchmark client build outputs and Python bytecode. Benchmark *results*
# (benchmarks/results/) are committed on purpose: they are the evidence
# behind the published report.
/benchmarks/kvbench/build/
__pycache__/

# .NET build outputs and IDE state.
bin/
obj/
*.user
.vs/
TestResults/

# Local test data (snapshots are generated by tests/tools, never committed).
*.kvs
/tmp/

# Office lock files: Word creates "~$<name>.docx" next to a document while it
# is open (docs/paper), and a broad `git add` would publish it.
~$*
